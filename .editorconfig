root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.dart]
indent_style = tab
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{gradle,gradle.kts,kt,kts}]
indent_style = space
indent_size = 4

[*.{xml,plist}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
