root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_size = 4
trim_trailing_whitespace = true

[*.dart]
indent_style = tab

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{gradle,gradle.kts,kt,kts}]
indent_style = space

[*.{xml,plist}]
indent_style = space

[*.md]
trim_trailing_whitespace = false
