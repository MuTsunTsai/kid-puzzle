{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"types": [
			"serviceworker",
			"node"
		],
		"lib": [
			"ES2022",
			"WebWorker"
		]
	},
	"include": [
		"src/**/*.ts",
		"rsbuild.config.ts"
	]
}
