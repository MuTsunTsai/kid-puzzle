{
	"name": "kid-puzzle-tooling",
	"private": true,
	"description": "幼兒益智遊戲的工具腳本（目前只有 service worker build）",
	"type": "module",
	"scripts": {
		"dev:web": "flutter run -d chrome --wasm --web-hostname=0.0.0.0 --web-port=49985 --web-launch-url=http://localhost:49985/",
		"build:sw": "rsbuild build --config service/rsbuild.config.ts",
		"build:web": "pnpm build:sw && flutter build web --no-wasm-dry-run --release --pwa-strategy=none --base-href /kid-puzzle/",
		"preview": "node tools/preview.mjs"
	},
	"devDependencies": {
		"@rsbuild/core": "^1.1.0",
		"@types/node": "^22.10.0",
		"@types/serviceworker": "^0.0.135",
		"polka": "^1.0.0-next.28",
		"sirv": "^3.0.0",
		"typescript": "^5.7.0",
		"workbox-cacheable-response": "^7.3.0",
		"workbox-core": "^7.3.0",
		"workbox-precaching": "^7.3.0",
		"workbox-routing": "^7.3.0",
		"workbox-strategies": "^7.3.0"
	}
}
