{
	"[dart]": {
		"editor.formatOnSave": false,
		"editor.formatOnType": false,
		"editor.insertSpaces": false,
		"editor.tabSize": 2
	},
	"cSpell.words": [
		"credentialless",
		"precache",
		"precaching",
		"rsbuild",
		"voronoi",
		"workbox"
	],
	"dart.enableSdkFormatter": false,
	"dart.lineLength": 100,
	"editor.detectIndentation": false,
	"editor.insertSpaces": false,
	"editor.tabSize": 2,
	"files.exclude": {
		".idea/": true,
		".dart_tool/": true,
		".flutter-plugins-dependencies": true
	},
	"files.encoding": "utf8",
	"files.eol": "\n"
}
